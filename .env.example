APP_ENV=development
BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./data/workout_relay.db
COOKIE_SECURE=false
GARMIN_MODE=mock

# Required in production and when GARMIN_MODE=live. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=

SESSION_DAYS=30
PLAN_RETENTION_DAYS=90
MAX_PLAN_BYTES=1048576

# File-delivery probe (see docs/MCP_PROBE.md). Serves synthetic sample files
# only; keep it off unless a compatibility test is running.
MCP_PROBE_ENABLED=false
MCP_PROBE_TOKEN=
MCP_PROBE_SAMPLES_DIR=
# Extra Host headers to answer for, comma separated, if BASE_URL is not the
# public hostname. Without a match the SDK replies 421 Misdirected Request.
MCP_PROBE_ALLOWED_HOSTS=
